# Mapbox public access token (pk.…) for the destination maps. Optional —
# without it the map surfaces render blank rather than crashing. Restrict the
# token by scope in your Mapbox account before shipping (docs/maps-setup.md).
MAPBOX_ACCESS_TOKEN=pk.your-public-token-here

# That is the whole configuration. The artifact catalog and destination photos
# are bundled with the app (assets/backend_snapshot/README.md), so there is no
# backend URL and no sign-in to set up.
