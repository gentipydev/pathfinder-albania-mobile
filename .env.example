# Supabase project — required for auth and persisted user data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt-here

# Travel Buddy FastAPI backend.
# In debug builds this is optional (falls back to the Render dev URL inside lib/config/env.dart);
# release builds must set it explicitly. The image manifest endpoints
# (/destinations/{slug}/photos, /destinations/{slug}/artifacts, /artifacts/{id})
# are served from this same host.
API_BASE_URL=https://your-backend.example.com
