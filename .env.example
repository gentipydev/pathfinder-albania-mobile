# Supabase project — required for auth and persisted user data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt-here

# Travel Buddy FastAPI backend.
# In debug builds this is optional (falls back to http://127.0.0.1:8000 inside
# lib/config/env.dart, which suits the iOS Simulator); release builds must set
# it explicitly. Android emulator: http://10.0.2.2:8000. Physical device: the
# host's LAN IP, with uvicorn bound to --host 0.0.0.0. The image manifest
# endpoints (/destinations/{slug}/photos, /destinations/{slug}/artifacts,
# /artifacts/{id}) are served from this same host.
API_BASE_URL=http://127.0.0.1:8000

# Mapbox public access token (pk.…) for the interactive maps. Optional —
# without it the map surfaces render blank rather than crashing. Restrict the
# token by URL/scope in your Mapbox account before shipping.
MAPBOX_ACCESS_TOKEN=pk.your-public-token-here

# TEMPORARY (debug builds only): set to true to skip the login screen while
# auth is being sorted out. Token-gated endpoints still return 401 without a session.
BYPASS_LOGIN=false

# Which parts of the app are on: showcase | full (default: full).
#   showcase = only the destinations showcase (home carousel + destination
#              details). No chat, trips, profile or sign-in; Supabase is not
#              used, so the SUPABASE_* keys may be left empty.
#   full     = showcase + the agent side (Explore/Buddy/My Trips/Profile nav).
APP_MODE=full
